<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
<GVL Name="GVL_HM" Id="{562a49e2-d16f-48b5-9bae-08a08881bd7a}">
<Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    nInterfaceRevision : UINT := 2;
    bEnable : BOOL := FALSE; // FALSE -> TRUE after starting PLC
    bStart : BOOL := FALSE; // one-shot; one homing per enable; 6098 configured in PREOP (17..22,37)
    bCancel : BOOL := FALSE; // one-shot; decelerates via Halt
    bReset : BOOL := FALSE; // one-shot; disabled only
    bReady : BOOL;
    bBusy : BOOL;
    bDone : BOOL;
    bCanceled : BOOL;
    bError : BOOL;
    bBusOk : BOOL;
    bTimingOk : BOOL;
    nState : UINT; // 0 disabled,10 enable,20 settle,30 ready,35 HM,40 done,45 cancel,50 canceled,90 error
    nError : UINT; // 1 bus,2 timing,3 drive fault,4 enable timeout,5 HM timeout,6 HM error,7 mode/state lost
    nStatusWord : UINT;
    nModeDisplay : SINT;
    nActualPosition : DINT; // counted electrical position, not encoder measurement
END_VAR
]]></Declaration>
</GVL>
</TcPlcObject>
